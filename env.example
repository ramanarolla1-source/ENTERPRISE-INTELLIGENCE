# ============================================================
# Enterprise Intelligence
# Environment Configuration Template
# ============================================================

# -----------------------------
# Application
# -----------------------------

APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------
# Flare Network
# -----------------------------

# Example:
# FLARE_NETWORK=coston2
FLARE_NETWORK=coston2

# RPC endpoint for the selected Flare network.
# Replace with an appropriate RPC endpoint for live testing.
FLARE_RPC_URL=

# Chain ID for the selected network.
# Set this when configuring a live/test deployment.
FLARE_CHAIN_ID=

# -----------------------------
# Enterprise Decision Contract
# -----------------------------

# Deployed EnterpriseDecisionRegistry address.
ENTERPRISE_DECISION_REGISTRY_ADDRESS=

# Deployed TrustReceiptRegistry address.
TRUST_RECEIPT_REGISTRY_ADDRESS=

# -----------------------------
# Smart Account
# -----------------------------

# Enterprise / executive Smart Account address.
SMART_ACCOUNT_ADDRESS=

# Private key should ONLY be supplied through a secure local environment.
# NEVER commit a real private key to Git.
SMART_ACCOUNT_PRIVATE_KEY=

# -----------------------------
# FDC / Web2Json
# -----------------------------

# FDC configuration for the selected Flare environment.
FDC_HUB_ADDRESS=

# Web2Json verifier / related protocol address if required by the
# deployment configuration.
FDC_VERIFIER_ADDRESS=

# Optional API or service endpoint used by the application to submit
# or retrieve FDC-related requests.
FDC_API_URL=

# -----------------------------
# Public Data Sources
# -----------------------------

# Optional endpoint for the demonstration/public-data adapter.
PUBLIC_DATA_API_URL=

# API key for a public data provider, when required.
PUBLIC_DATA_API_KEY=

# -----------------------------
# AI Source / Decision Intelligence
# -----------------------------

# AI provider used by a live implementation.
# Examples: openai, anthropic, local
AI_PROVIDER=

# Model identifier for the selected AI provider.
AI_MODEL=

# API key for the selected AI provider.
# Leave blank for the deterministic prototype implementation.
AI_API_KEY=

# -----------------------------
# Trust Receipt Storage
# -----------------------------

# Protected storage location for encrypted Trust Receipts.
# Example:
# TRUST_RECEIPT_STORAGE_URL=
TRUST_RECEIPT_STORAGE_URL=

# Encryption key reference / secret for local demonstration purposes.
# Production deployments should use a proper enterprise KMS/HSM.
TRUST_RECEIPT_ENCRYPTION_KEY=

# -----------------------------
# Demo / Prototype
# -----------------------------

# DEMONSTRATION:
#   Uses synthetic evidence and placeholder FDC identifiers.
#
# LIVE:
#   Uses configured Flare/FDC infrastructure.
DEMO_MODE=true

# When true, the application must reject placeholder transaction
# hashes/addresses during live execution.
REQUIRE_LIVE_CHAIN_DATA=false
